require_once dirname(__DIR__) . '/app/Helpers/layout.php';

use App\Services\PermissionService;

PermissionService::require('users.manage');

$pdo = db();

$roles = $pdo->query("
    SELECT id, name
    FROM roles
    ORDER BY name ASC
")->fetchAll(PDO::FETCH_ASSOC);

render_header('Nieuwe gebruiker');
?>

<div class="card">

